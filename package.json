  "engines": {
    "node": ">=22.22.3 <23",
    "npm": ">=10.9.7 <11"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "ng": "ng",
    "build:blog-index": "node ./src/scripts/generate-blog-index.js",
    "build": "npm run build:blog-index && ng build",
