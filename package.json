{
  "name": "nati-psy",
  "version": "0.0.0",
  "engines": {
    "node": "22.22.3",
    "npm": "10.9.9"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "preinstall": "node ./scripts/check-toolchain.mjs",
    "ng": "ng",
    "build:blog-index": "node ./src/scripts/generate-blog-index.js",
    "audit:security": "node ./scripts/dependency-audit.mjs",
    "build:stats": "npm run build:blog-index && ng build --configuration production --stats-json",
    "report:bundle-size": "node ./scripts/report-bundle-size.mjs",
    "test:fonts": "node ./scripts/fonts-contract.test.mjs",
    "test:nginx-security": "node ./scripts/nginx-security-headers.test.mjs",
    "test:blog-images": "node ./scripts/blog-image-contract.test.mjs",
    "test:ssr-server": "node ./scripts/ssr-server-contract.test.mjs",
    "test:ssr-server-security": "node --test scripts/ssr-server-security.test.mjs",
    "test:ssr-server:http": "node --test scripts/ssr-built-server-security.test.mjs",
    "test:nginx:live": "node --test scripts/nginx-live-contract.test.mjs",
    "test:mobile-home": "node ./scripts/mobile-home-conversion.test.mjs",
    "test:blog-generator": "node --test src/scripts/validate-blog-content.test.js scripts/assert-public-content.test.mjs src/scripts/watch-blog-index.test.js",
    "test:public-content": "node --test scripts/assert-public-content.test.mjs",
    "test:rss-feed": "node ./scripts/rss-feed-contract.test.mjs",
    "test:rss-feed:fixtures": "node ./scripts/rss-feed-fixtures.test.mjs",
    "test:rss-feed:http": "node ./scripts/rss-feed-http.test.mjs",
    "test:pagination-prerender": "node ./scripts/pagination-prerender-contract.test.mjs",
    "test:accessibility-interactions": "node ./scripts/accessibility-interactions.test.mjs",
    "assert:public-content": "node scripts/assert-public-content.mjs",
    "test:hydration-cache": "node ./scripts/hydration-cache-contract.test.mjs",
    "test:hydration-render": "node scripts/hydration-render-contract.mjs",
    "test:tailwind-source-boundary": "node ./scripts/tailwind-source-boundary.test.mjs",
    "test:container": "node ./scripts/container-contract.test.mjs",
    "test:blog-seo": "node ./scripts/blog-seo-fields.test.mjs",
    "test:structured-data": "node ./scripts/structured-data-prerender-contract.test.mjs",
    "test:assets-favicon": "node ./scripts/assets-favicon.test.mjs",
    "build": "npm run build:blog-index && ng build && npm run assert:public-content",
    "start": "npm run build:blog-index && node ./src/scripts/dev-watch.js --serve",
    "watch": "npm run build:blog-index && node ./src/scripts/dev-watch.js",
    "test": "ng test",
    "test:ci-config": "node --test scripts/ci-config.test.mjs",
    "test:robots": "node --test scripts/robots-smoke-check.test.mjs",
    "smoke:robots": "node scripts/robots-smoke-check.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "test:lazy-bundle": "npm run build:stats && node --test scripts/lazy-blog-bundle.test.mjs",
    "test:smoke": "node --test scripts/deploy-smoke-check.test.mjs",
    "smoke:production": "node scripts/deploy-smoke-check.mjs",
    "toolchain:check": "node ./scripts/toolchain-contract.test.mjs",
    "serve:ssr:NatiPsy": "node dist/nati-psy/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/forms": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/platform-server": "22.1.5",
    "@angular/router": "22.1.5",
    "@angular/ssr": "22.1.7",
    "dompurify": "^3.4.14",
    "express": "^5.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/compiler-cli": "22.1.5",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.0.1",
    "marked": "^18.0.11",
    "postcss": "8.5.27",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
