# Repository and local dependency trees never belong in the build context.
.git
.git/**
node_modules
dist
.angular
coverage

# Editor, OS, logs, and disposable audit output.
.idea
.vscode
*.iml
*.log
*.swp
.DS_Store
audit-screenshots
tmp
temp

# Local configuration and credentials. Keep only an explicitly named example.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12

# Generated archives and caches.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache
.npm
